# Entity service
ENTITY_BASE_URL=
ENTITY_TOKEN_URL=
ENTITY_CLIENT_ID=
ENTITY_CLIENT_SECRET=
ENTITY_SCOPES=

# Server
PORT=8080
# Per-operation scope check on every route except GET /health (default true).
# Set to false only for local development against a client that forwards no token.
REQUIRE_OPERATION_SCOPES=true
