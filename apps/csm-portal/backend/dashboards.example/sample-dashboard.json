{
  "id": "sample-dashboard",
  "displayName": "Sample Dashboard",
  "type": "cs",
  "isDefault": true,
  "targetTeam": "sample-team",
  "isTeamBased": false,
  "widgets": [
    {
      "id": "my-open-cases",
      "displayName": "My Open Cases",
      "resourceType": "case",
      "shape": "count",
      "gridWidth": 3,
      "query": {
        "filters": [
          {
            "field": "assignedUserId",
            "op": "in",
            "values": [
              "__current_user__"
            ]
          },
          {
            "field": "state",
            "op": "in",
            "values": [
              "open",
              "work_in_progress"
            ]
          }
        ]
      }
    },
    {
      "id": "recent-cases",
      "displayName": "Recent Cases",
      "resourceType": "case",
      "shape": "list",
      "gridWidth": 6,
      "listLimit": 5,
      "query": {
        "filters": [
          {
            "field": "tag",
            "op": "in",
            "values": [
              "example-tag"
            ]
          },
          {
            "field": "tag",
            "op": "notIn",
            "values": [
              "excluded-example-tag"
            ]
          }
        ]
      }
    },
    {
      "id": "pending-time-cards",
      "displayName": "Pending Time Cards",
      "resourceType": "time_card",
      "shape": "count",
      "gridWidth": 3,
      "query": {
        "states": [
          "pending"
        ]
      }
    }
  ]
}
